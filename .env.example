OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: OpenAI-compatible endpoint. Defaults to https://api.openai.com/v1
OPENAI_BASE_URL=

# 高德地图 JS API 2.0
# 一个 Key 只对应一个服务平台，需分别创建两个 Key
# NEXT_PUBLIC_AMAP_KEY: 选「Web端(JS API)」，前端地图渲染
# NEXT_PUBLIC_AMAP_SECURITY_CODE: 同一页面生成的安全密钥(jscode)，前端必须带上
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=
# AMAP_KEY: 选「Web服务」，服务端地理编码；不填则回落到内置城市坐标表
AMAP_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

WEATHER_API_KEY=
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
HOTEL_API_KEY=
ATTRACTION_API_KEY=
FOOD_API_KEY=

# Optional generic search fallback. If omitted, the app tries DuckDuckGo Lite public search.
# SEARCH_API_ENDPOINT can point to Tavily/SerpAPI/Bing-compatible proxy if you add one.
SEARCH_API_KEY=
SEARCH_API_ENDPOINT=
